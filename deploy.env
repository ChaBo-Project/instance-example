# Deploy values for the `<INSTANCE_NAME>` instance. Read by .github/workflows/deploy.yml,
# which pins the ChaBo-Deploy version this instance deploys through — see that workflow
# file for the actual @ref pin.

CHABO_TAG=<fill in — published chabo-rag-orchestrator version, e.g. 0.9.1>
ORCHESTRATOR_HF_SPACE=<fill in — org/space-name, e.g. myorg/myinstance_Orchestrator>
QDRANT_HF_SPACE=<fill in — org/space-name, e.g. myorg/myinstance_Qdrant>
INSTANCE_URL=<fill in — https://myorg-myinstance-orchestrator.hf.space>

# --- Qdrant Space Variables/Secrets ---
# Never applied by CI — set by hand in the Space's own Settings panel (see
# qdrant/README.md). Documented here per the org's "knowledge lives in the repository,
# not in a person" rule so the values aren't only in one person's head.
#
# Required Variables (no code default, or a default you shouldn't rely on):
# EMBEDDING_DATASET=<fill in — HF Dataset repo id>
# COLLECTION_NAME=<fill in>
# EMBEDDING_DIMENSION=1024
#
# Optional Variables (code defaults exist, override only if needed):
# VECTOR_COLUMN_NAME=vector
# BATCH_SIZE=200
# TOP_K=10
#
# Secrets (also set via the Space panel, not here):
# QDRANT__SERVICE__API_KEY, DATASET_READ_TOKEN

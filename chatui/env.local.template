# Hugging Face ChatUI environment template for ChaBo instances.
#
# Based on ChaBo-ChatUI's root .env file.
# Re-synchronize this template whenever CHATUI_TAG is upgraded.
#
# Deployment-specific differences:
# - PUBLIC_ORIGIN and PUBLIC_APP_NAME are inserted by the workflow.
# - Inside MODELS below, only displayName and the endpoint URLs are filled in by the
#   workflow (from INSTANCE_NAME/INSTANCE_URL) — every other field (description,
#   promptExamples, instructions, multimodal, chatPromptTemplate, parameters) is a
#   literal edited directly in this file, not driven by deploy.env.
# - MONGODB_URL uses the MongoDB embedded in the ChatUI database image.
# - HF_TOKEN and all other secrets are configured outside this public file.
#
# Do not add tokens, passwords, API keys, or other sensitive data here.

# TIER LEGEND (added during section-by-section review, applied incrementally —
# an unmarked var hasn't been reviewed against this scale yet):
#   [TIER 1] Leave as shipped unless you specifically know you need to change it.
#            Safe default, or an edge case that doesn't apply to a normal deployment.
#   [TIER 2] Must be deliberately set for EVERY real ChaBo instance/deployment —
#            copying the template value verbatim is wrong or risky for more than one instance.

# ============================================================
# Database
# ============================================================
# ----------------------[TIER 1]------------------------------
MONGODB_URL=mongodb://localhost:27017
MONGODB_DB_NAME=chabo-chatui
MONGODB_DIRECT_CONNECTION=false

# ============================================================
# Cookies / session
# ============================================================
# ----------------------[TIER 2]------------------------------
COOKIE_NAME=chabo-chatui
# ----------------------[TIER 1]------------------------------
COOKIE_SAMESITE=
COOKIE_SECURE=
# Adding `partitioned` (CHIPS) lets the session cookie survive browser cookie blocking when the app
# is embedded in an iframe. Defaults to true whenever the cookie is `SameSite=None; Secure`
# Set to `false` to opt out, `true` to force it on.
COOKIE_PARTITIONED=
# recommended to keep this to false but set to true if you need to run over http without tls
ALLOW_INSECURE_COOKIES=false

# ============================================================
# ChaBo / HF backend auth
# ============================================================
# ----------------------[TIER 2]------------------------------
# HF_TOKEN is configured separately as a Hugging Face Space secret.

# ============================================================
# Model configuration
# ============================================================
# ----------------------[TIER 2]------------------------------
# 'name', 'userMessageToken', 'assistantMessageToken' are required. Whole block is
# per-deployment. The one field that MUST change for every real instance:
# endpoints[].url / streamingFileUploadUrl MUST be set to your real orchestrator
# instance before deploying — the placeholder below is not a working endpoint.
# Everything else — name/displayName/description/promptExamples/chatPromptTemplate/
# datasetUrl/logoUrl — is customizable content, not a functional requirement; see
# models-field-reference.md for the full field-by-field reference (already
# live-verified, not re-walked here).
# [TIER 1] `preprompt` intentionally omitted (defaults to "") — it's the one
# field that actually reaches the orchestrator as its own payload field, but
# left empty until there's a reason to set it. `instructions` also
# intentionally omitted — leaving it out renders no "How to Use" card at all,
# which is the desired state for now (re-add later with real content if wanted).
MODELS=`[
  {
    "name": "ChaBo",
    "displayName": "${INSTANCE_NAME} Assistant",
    "description": "Retrieval-augmented generation powered by ChaBo.",
    "promptExamples": [
      {
        "title": "Who are you",
        "prompt": "What is this chatbot about?"
      },
      {
        "title": "Ask a RAG question",
        "prompt": "What programmes had been implemented?"
      },
      {
        "title": "Tell me about ChaBo",
        "prompt": "What is ChaBo?"
      }
    ],
    "instructions": {
      "title": "Instructions",
      "content": "Ask questions about the available documents. Answers may include source citations."
    },
    "multimodal": true,
    "multimodalAcceptedMimetypes": [
      "application/pdf"
    ],
    "chatPromptTemplate": "{{#each messages}}{{#ifUser}}{{content}}{{/ifUser}}{{#ifAssistant}}{{content}}{{/ifAssistant}}{{/each}}",
    "parameters": {
      "temperature": 0.0,
      "max_new_tokens": 2048
    },
    "endpoints": [
      {
        "type": "langserve-streaming",
        "url": "${INSTANCE_URL}/chatfed-ui-stream",
        "streamingFileUploadUrl": "${INSTANCE_URL}/chatfed-with-file-stream",
        "inputKey": "text",
        "fileInputKey": "files"
      }
    ]
  }
]`

# ============================================================
# App branding / theming
# ============================================================
# ----------------------[TIER 1]------------------------------
# Used to find logos and favicons in the selected static asset directory.
PUBLIC_APP_ASSETS=chabo-official
# set to 1 to show a disclaimer on login page
PUBLIC_APP_DISCLAIMER=1
PUBLIC_APP_DISCLAIMER_MESSAGE="You are chatting with an AI assistant, not a human. Answers are generated from a curated document collection and can be incomplete or wrong — please verify before acting on them. Do not enter personal or sensitive information, especially health data. We record usage statistics to improve the service; details and your rights are in the"
# URL for reporting issues, shown on the feedback link
PUBLIC_APP_ISSUE_URL=https://github.com/ChaBo-Project/ChaBo-ChatUI/issues
# base path of the app, e.g. /chat, left blank as default — only matters for subpath deployments
APP_BASE=""
# can be any of tailwind colors: https://tailwindcss.com/docs/customizing-colors#default-color-palette
# BUILD TIME ONLY — has zero effect via this runtime .env.local file. The real default lives in the
# Dockerfile's `ARG PUBLIC_APP_COLOR=blue`; only a rebuild changes it.
PUBLIC_APP_COLOR=blue
# left unset to chose HuggingFace's original default colors with the ChaBo logo
PUBLIC_APP_BACKGROUND=
# left unset — same decision as above
PUBLIC_APP_SURFACE=
# left unset — defaults to gray-900, no official dark palette yet
PUBLIC_APP_BACKGROUND_DARK=
# left unset — defaults to gray-800, no official dark palette yet
PUBLIC_APP_SURFACE_DARK=
# set to 1 to enable options & text regarding data sharing
PUBLIC_APP_DATA_SHARING=1
# a message to the guest user. If not set, a default message will be used — only relevant with
# guest mode, not used by ChaBo's anonymous-only setup
PUBLIC_APP_GUEST_MESSAGE=

# explicit empty array, not just commented out — commenting out alone does NOT remove the banner,
# it just stops overriding the base .env's own baked-in default, which is this same stock
# "Code Llama 70B is available!" content
PUBLIC_ANNOUNCEMENT_BANNERS=`[]`

# ----------------------[TIER 2]------------------------------

# description used throughout the app (if not set, a default one will be used)
PUBLIC_APP_DESCRIPTION=Interact with ChaBo
# name used as title throughout the app
PUBLIC_APP_NAME=${PUBLIC_APP_NAME_JSON}


# ============================================================
# Access control / usage limits
# ============================================================
# ----------------------[TIER 2]------------------------------
# Conservative real limits — each message hits the full embed -> retrieve -> rerank -> generate
# pipeline, so this protects a publicly-embedded, cost-bearing endpoint from abuse. Values here
# are a starting point — tune once you see real traffic/cost patterns for an instance.
# `assistants`/`tools` deliberately left out — dead since those features are unused.
USAGE_LIMITS=`{
  // how many messages a single session/IP can send per minute, across all conversations.
  // Sliding 60s window, checked against events already recorded before the current request.
  "messagesPerMinute": 10,
  // how many messages a single conversation can hold before it must start a new one.
  "messages": 50,
  // how many characters a single message can be, checked before the request ever reaches the
  "messageLength": 2000,
  // how many conversations a single session/IP can create in total.
  "conversations": 20
}`
# ----------------------[TIER 1]------------------------------
# only matters when requiresUser/OIDC is active — inert for ChaBo's anonymous-only setup, same
# reason ALLOWED_USER_EMAILS moved to the OpenID section (left here since it's a real access-control
# concept, not OIDC-specific config)
MESSAGES_BEFORE_LOGIN=# how many messages a user can send in a conversation before having to login. set to 0 to force login right away
BODY_SIZE_LIMIT=15728640

# ============================================================
# Admin / metrics / export
# ============================================================
# secret to admin API calls, like computing usage stats or exporting parquet data
# WARNING: leave this BLANK, don't fill it with a placeholder. Unlike METRICS_SECRET below,
# ADMIN_API_SECRET fails CLOSED when unset (hooks.server.ts:104 returns 500 "Admin API is not
# configured" for every /admin/* route). A shipped placeholder here would flip that to fail-OPEN
# with a known credential — anyone who reads this public template could then hit
# /admin/export (parquet export of full conversations, once PARQUET_EXPORT_DATASET +
# PARQUET_EXPORT_HF_TOKEN are also set) using that same string as the Bearer token. Set a real
# secret only when you deliberately enable admin/export features for an instance.
ADMIN_API_SECRET=
PARQUET_EXPORT_DATASET=
PARQUET_EXPORT_HF_TOKEN=
# /metrics runs on its own separate Express server (its own port, never touches hooks.server.ts),
# so it needed its own auth implementation — added 2026-08-31, src/lib/server/metrics.ts.
# Optional: if METRICS_SECRET is unset, /metrics stays open (same as before); if set, requires
# `Authorization: Bearer <METRICS_SECRET>` or returns 401. Same Bearer-token pattern as
# ADMIN_API_SECRET, just enforced inside metrics.ts's own route handler instead of hooks.server.ts.
# Unlike ADMIN_API_SECRET, blank here fails OPEN (no auth at all), so this one DOES ship with an
# obvious placeholder below — replace it with a real secret, don't leave the placeholder in place.
METRICS_SECRET=
METRICS_ENABLED=false
METRICS_PORT=5565

# ============================================================
# Embedding
# ============================================================
# ----------------------[TIER 2]------------------------------
# Binary switch true means no frame-ancestors CSP restriction at all (anyone can embed).
ALLOW_IFRAME=true

# ============================================================
# Public metadata
# ============================================================
# ----------------------[TIER 2]------------------------------
# App's canonical public URL. Used for og:/icon tags, the CSRF origin check, and the "open in a new
# tab" fallback link. Still a placeholder — needs the real instance URL once one exists.
PUBLIC_ORIGIN=${PUBLIC_ORIGIN_JSON}
# ----------------------[TIER 1]------------------------------
# Has a sane fallback (PUBLIC_ORIGIN, else page origin) — only set explicitly if share links should
# differ from the canonical origin.
PUBLIC_SHARE_PREFIX=#https://hf.co/chat

# Google Analytics tracking ID. Set a real one to enable tracking; blank = no tracking at all.
PUBLIC_GOOGLE_ANALYTICS_ID=#G-XXXXXXXX / Leave empty to disable

# Same idea, for Plausible (a simpler, privacy-friendlier analytics alternative). Optional.
PUBLIC_PLAUSIBLE_SCRIPT_URL=#/js/script.js / Leave empty to disable

# Apple "Open in App" banner — only relevant if ChaBo ships an iOS app. It doesn't, so this is dead
# for now, kept as a placeholder.
PUBLIC_APPLE_APP_ID=#1234567890 / Leave empty to disable

# Cosmetic only: false = tokens appear exactly as streamed; true = smoothed typing animation.
PUBLIC_SMOOTH_UPDATES=false


# ============================================================
# Ops
# ============================================================
# ----------------------[TIER 1]------------------------------
# Gates the separate /api/* REST surface (403 "API is disabled" if not exactly "true") — the
# frontend UI itself never calls /api/*, so this only affects external/scripted access.
# interim: deliberately false (upstream default is true) since nothing needs it yet — revisit
# with a proper API-key gate before re-enabling for external integrations.
EXPOSE_API=false
# HuggingChat-specific: lets /api/* callers auth with a real HF token. Requires locals.user (OIDC
# login), which ChaBo never has — dead for ChaBo either way.
USE_HF_TOKEN_IN_API=false
LOG_LEVEL=info

# ============================================================
# OpenID / OAuth / trusted-header auth — untested/unused for ChaBo, see README's
# "Untested upstream features"
# ============================================================
TRUSTED_EMAIL_HEADER= # only set this if you understand the implications — alternative to OpenID below, trusts a header instead of an OIDC handshake
# Parameters to enable open id login
OPENID_CONFIG=`{
  "PROVIDER_URL": "",
  "CLIENT_ID": "",
  "CLIENT_SECRET": "",
  "SCOPES": "",
  "NAME_CLAIM": ""
}`

# /!\ legacy openid settings, prefer the config above
OPENID_CLIENT_ID=
OPENID_CLIENT_SECRET=
OPENID_SCOPES="openid profile" # Add "email" for some providers like Google that do not provide preferred_username
OPENID_NAME_CLAIM="name" # Change to "username" for some providers that do not provide name
OPENID_PROVIDER_URL=https://huggingface.co # for Google, use https://accounts.google.com
OPENID_TOLERANCE=
OPENID_RESOURCE=

ALTERNATIVE_REDIRECT_URLS=`[]` #valide alternative redirect URL for OAuth

HF_ORG_ADMIN=
HF_ORG_EARLY_ACCESS=

# if it's defined, only these emails will be allowed to use the app. Only checked in the OIDC
# login callback (login/callback/+page.server.ts) — inert without OPENID_CONFIG set, same as
# the vars above
ALLOWED_USER_EMAILS=`[]`


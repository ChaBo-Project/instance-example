# Instance-specific ChatUI overrides uploaded to Hugging Face as DOTENV_LOCAL.
#
# This is intentionally not a complete list of every ChaBo-ChatUI variable.
# Defaults remain owned by ChaBo-ChatUI's root .env file. Add settings here
# only when every deployed instance should deliberately override the default.

MODELS=`${MODELS_JSON}`
PUBLIC_ORIGIN=${PUBLIC_ORIGIN_JSON}
PUBLIC_APP_NAME=${PUBLIC_APP_NAME_JSON}
PUBLIC_APP_DESCRIPTION="Retrieval-augmented assistant powered by ChaBo."

PUBLIC_APP_ASSETS=chatui
PUBLIC_APP_DISCLAIMER=1
PUBLIC_APP_DISCLAIMER_MESSAGE="AI-generated answers may be inaccurate. Do not enter sensitive personal information."
PUBLIC_ANNOUNCEMENT_BANNERS=`[]`

ENABLE_ASSISTANTS=false
ENABLE_ASSISTANTS_RAG=false
COMMUNITY_TOOLS=false
LLM_SUMMARIZATION=false

MONGODB_URL=mongodb://localhost:27017

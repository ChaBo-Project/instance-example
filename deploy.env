# ==============================================================================
# ChaBo instance deployment configuration
# ==============================================================================
#
# This file contains PUBLIC, non-secret deployment configuration.
# It is committed to GitHub and read by the deployment workflow.
#
# In this public template, instance-specific values must remain empty.
# Fill them only after creating a private instance repository.
#
# SECURITY:
# - Never add tokens, passwords, API keys or other secrets here.
# - Store secrets in GitHub Actions secrets or Hugging Face Space secrets.
# - All example organization and resource names below are fictional.
# ==============================================================================


# ------------------------------------------------------------------------------
# 1. Instance identity
# ------------------------------------------------------------------------------

# Required: Short name identifying this ChaBo installation.
# Example: chabo-demo
INSTANCE_NAME=""

# Required: Published chabo-rag-orchestrator image version.
# Example: 0.9.1
CHABO_TAG=""

# Required: ChaBo-Deploy release used for all three Space deployments.
# Update this value when selecting a newer compatible release.
CHABO_DEPLOY_REF="hf-spaces-v0.2.1"

# Required: Published ChaBo ChatUI image version.
# Example: 0.9.2
CHATUI_TAG=""


# ------------------------------------------------------------------------------
# 2. Hugging Face Spaces and Collection
# ------------------------------------------------------------------------------

# Required: Orchestrator Space repository ID.
# The workflow creates this Space automatically if it does not exist.
# Format: organization/space-name
# Example: your-org/chabo-demo-orchestrator
ORCHESTRATOR_HF_SPACE=""

# Required: Qdrant Space repository ID.
# The workflow creates this Space automatically if it does not exist.
# Format: organization/space-name
# Example: your-org/chabo-demo-qdrant
QDRANT_HF_SPACE=""

# Required: ChatUI Space repository ID.
# The workflow creates this Space automatically if it does not exist.
# Format: organization/space-name
# Example: your-org/chabo-demo-ui
CHATUI_HF_SPACE=""

# Required: Controls whether the ChatUI Space is private.
# Allowed values: true or false
CHATUI_HF_SPACE_PRIVATE="false"

# Required: Hugging Face Collection grouping this deployment.
# This is different from the Qdrant COLLECTION_NAME below.
# Example: ChaBo Demo
HF_COLLECTION_TITLE=""

# Required: Visibility of the Hugging Face Collection.
# Allowed values: true or false
HF_COLLECTION_PRIVATE="false"

# Required: The Orchestrator and Qdrant Spaces must remain private.
# This value must be true.
HF_SPACES_PRIVATE="true"

# Required: Orchestrator Space URL without a trailing slash.
# Example: https://your-org-chabo-demo-orchestrator.hf.space
INSTANCE_URL=""

# Required: Qdrant Space URL without a trailing slash.
# Example: https://your-org-chabo-demo-qdrant.hf.space
QDRANT_URL=""

# Required: ChatUI Space URL without a trailing slash.
# Example: https://your-org-chabo-demo-ui.hf.space
CHATUI_URL=""


# ------------------------------------------------------------------------------
# 3. Qdrant and embeddings Dataset
# ------------------------------------------------------------------------------

# Required: Hugging Face Dataset containing the embedded documents.
# Format: organization/dataset-name
# Example: your-org/chabo-demo-embeddings
EMBEDDING_DATASET=""

# Required: Qdrant collection used by both backend Spaces.
# Example: chabo-demo-bgem3-512
COLLECTION_NAME=""

# Required: Must match the embedding model's vector size.
EMBEDDING_DIMENSION="1024"

# Optional: Name of the Dataset column containing vectors.
VECTOR_COLUMN_NAME="vector"

# Optional: Number of Dataset rows processed in one batch.
BATCH_SIZE="200"

# Optional: Maximum number of search results returned by Qdrant.
TOP_K="10"

# Optional: Metadata fields used to filter document searches.
# Also creates a Qdrant payload index per field, which keeps filtered
# search fast on large collections. The type must match the stored values.
# Leave empty to keep filtering disabled.
# Format: field:type,field:type — supported types: str, int, list.
FILTERABLE_FIELDS=""

# Optional: Qdrant search timeout, a whole number of seconds.
# Leave empty to use the qdrant-client default.
QDRANT_TIMEOUT=""


# ------------------------------------------------------------------------------
# Pipeline settings
# ------------------------------------------------------------------------------
#
# Embedding/reranker endpoints, answer generator, query rewriter, metadata
# fields and guards are edited directly in
# orchestrator/instance_config/params.override.cfg.template.


# ==============================================================================
# Secret names — never add their values to this file
# ==============================================================================
#
# Required GitHub Actions secret:
#   HF_TOKEN
#
# Optional GitHub Actions secrets:
#   CHATUI_BACKEND_TOKEN
#   QDRANT__SERVICE__API_KEY
#   DATASET_READ_TOKEN
#
# ChatUI Space secret:
#   HF_TOKEN
#
# Required GitHub Actions secret when [generator] PROVIDER is azure:
#   AZURE_API_KEY
#
# Orchestrator Space secrets:
#   HF_TOKEN
#   QDRANT_API_KEY
#   AZURE_API_KEY — copied when supplied; required for Azure generation
#
# Qdrant Space secrets:
#   QDRANT__SERVICE__API_KEY
#   DATASET_READ_TOKEN
# ==============================================================================
